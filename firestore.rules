rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate: Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidAgent(data) {
      return data.keys().hasAll(['role', 'mode', 'skills', 'ownerId', 'createdAt', 'updatedAt'])
        && data.role is string && data.role.size() <= 200
        && data.mode in ['executor', 'critic', 'simulator', 'agent']
        && data.skills is list && data.skills.size() <= 100
        && data.ownerId is string && data.ownerId.size() <= 128
        // During create, owner must be caller (unless it's system migration, but here we enforce caller)
        && (request.method == 'create' ? data.ownerId == request.auth.uid : true)
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['goal', 'status', 'userId', 'createdAt', 'updatedAt'])
        && data.goal is string && data.goal.size() <= 5000
        && data.status in ['planning', 'executing', 'synthesizing', 'completed', 'failed']
        && data.userId == request.auth.uid
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['jobId', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.jobId is string && isValidId(data.jobId)
        && data.description is string && data.description.size() <= 10000
        && data.status in ['pending', 'in_progress', 'done', 'failed', 'iterating']
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    // --- Collections ---

    // Agents
    match /agents/{agentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && isValidAgent(incoming());
      allow update: if isSignedIn() && (isOwner(existing().ownerId) || existing().ownerId == 'system') && (
        isValidAgent(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'role', 'mode', 'skills', 'experience_level', 'strengths', 'weaknesses', 'tools', 
          'behavior_rules', 'context_budget', 'priority_bias', 'capability_vector', 
          'level', 'exp', 'skill_points', 'reputation', 'reputation_tokens', 'trustScore', 'lifecycle_stage', 
          'satisfaction', 'lineage', 'persona_metadata', 'reputation_history', 'institution_id', 'guild_name', 'ownerId', 'updatedAt'
        ])
      );
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    // Jobs
    match /jobs/{jobId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidJob(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && (
        isValidJob(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'current_iteration', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Tasks (Subcollection)
    match /jobs/{jobId}/tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource == null || 
        get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid
      ) && isValidTask(incoming());
      allow update: if isSignedIn() && (
        resource == null || 
        get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid
      ) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'output', 'confidence', 'startTime', 'duration', 'updatedAt', 'complexity',
          'assigned_agents', 'bids', 'winning_bid', 'parent_task_id', 'is_delegated',
          'delegated_by', 'delegated_to', 'delegation_reason', 'subtask_ids'
        ])
      );
      allow delete: if isSignedIn() && (
        resource == null || 
        get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid
      );
    }

    // Tasks (CollectionGroup)
    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource == null || 
        resource.data.userId == request.auth.uid
      );
    }

    // Evaluations (Sub-subcollection)
    match /jobs/{jobId}/tasks/{taskId}/evaluations/{evalId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid;
      allow create: if isSignedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid;
    }

    // Institutions
    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    // Relationships
    match /relationships/{relId} {
      allow get: if isSignedIn() && (
        get(/databases/$(database)/documents/agents/$(resource.data.sourceId)).data.ownerId == request.auth.uid || 
        get(/databases/$(database)/documents/agents/$(resource.data.targetId)).data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && (
        get(/databases/$(database)/documents/agents/$(incoming().sourceId)).data.ownerId == request.auth.uid || 
        get(/databases/$(database)/documents/agents/$(incoming().targetId)).data.ownerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/agents/$(existing().sourceId)).data.ownerId == request.auth.uid || 
        get(/databases/$(database)/documents/agents/$(existing().targetId)).data.ownerId == request.auth.uid
      );
    }
  }
}
