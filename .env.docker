# ==========================================
# Civitas AI - Docker Environment Variables
# ==========================================

# [AI LAYER] 
# Leave blank to trigger your app's "resilient offline simulation mode".
# Add your real key here if you want live Gemini API calls in Docker.
GEMINI_API_KEY=

# [FIREBASE LAYER - FOR VITE FRONTEND]
# Note: Since the React app runs in the browser, it connects to 'localhost' 
# on your host machine, which we mapped to port 8080 above.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-civitas-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-civitas-ai
VITE_FIREBASE_STORAGE_BUCKET=demo-civitas-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
